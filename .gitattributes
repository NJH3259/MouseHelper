# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Sources
*.c text
*.cc text
*.cxx text
*.cpp text
*.c++ text
*.h text
*.hh text
*.hxx text
*.h++ text
*.inl text
*.txt text

# Visual Studio project files use CRLF
*.sln text eol=crlf
*.slnx text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Binary assets should never be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.dds binary
*.tga binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.dll binary
*.lib binary
*.exe binary
*.pdb binary
